@page "/events"
@using GigHaus.Domain.Entities
@using GigHaus.Infrastructure.Repositories
@inject IEventRepository Repo
@rendermode InteractiveServer

<PageTitle>Events - GigHaus Admin</PageTitle>

<h2>Events</h2>

@if (_events is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr><th>Title</th><th>Artist</th><th>Host</th><th>Date</th><th>Time</th><th>Capacity</th><th>Status</th></tr>
        </thead>
        <tbody>
        @foreach (var ev in _events)
        {
            <tr>
                <td>@ev.Title</td>
                <td>@ev.Artist?.Name</td>
                <td>@ev.Host?.Name</td>
                <td>@ev.EventDate.ToString("MMM dd, yyyy")</td>
                <td>@ev.StartTime.ToString("h:mm tt")</td>
                <td>@ev.MaxAttendees</td>
                <td>@(ev.IsPublished ? "Published" : "Draft")</td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private IEnumerable<Event>? _events;

    protected override async Task OnInitializedAsync()
    {
        _events = await Repo.GetAllAsync();
    }
}

