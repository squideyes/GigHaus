@* Renders a still of the mascot that mascot.js upgrades to the looping video. *@
<img class="mascot @Class"
     src="mascot/mascot-@(StillSize).webp"
     alt="@Alt"
     width="@Size"
     height="@Size"
     data-mascot-video="@(Animated ? $"mascot/mascot-{VideoSize}.webm" : null)" />

@code {
    /// <summary>Display size in pixels.</summary>
    [Parameter] public int Size { get; set; } = 256;
    [Parameter] public bool Animated { get; set; } = true;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string Alt { get; set; } = "The GigHaus mascot, a cheerful yellow house playing an acoustic guitar";

    // Files are about twice the display size so they stay sharp on high-density screens.
    private int VideoSize => Size switch
    {
        <= 64 => 128,
        <= 128 => 256,
        _ => 512
    };

    private int StillSize => Size switch
    {
        <= 48 => 96,
        <= 160 => 320,
        _ => 640
    };
}
