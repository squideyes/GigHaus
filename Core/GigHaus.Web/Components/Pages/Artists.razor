@page "/artists"
@using GigHaus.Domain.Entities
@using GigHaus.Infrastructure.Repositories
@inject IArtistRepository Repo
@rendermode InteractiveServer

<PageTitle>Artists - GigHaus Admin</PageTitle>

<h2>Artists</h2>

@if (_artists is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Website</th>
                <th>Created</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in _artists)
            {
                <tr>
                    <td>@a.Name</td>
                    <td>@a.Email</td>
                    <td>@a.Phone</td>
                    <td>@a.Website</td>
                    <td>@a.CreatedAt.ToString("g")</td>
                    <td><a href="artists/@a.Id" class="btn btn-sm btn-outline-primary">Dashboard</a></td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IEnumerable<Artist>? _artists;

    protected override async Task OnInitializedAsync()
    {
        _artists = await Repo.GetAllAsync();
    }
}

