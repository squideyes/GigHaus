@page "/hosts"
@using GigHaus.Domain.Entities
@using GigHaus.Infrastructure.Repositories
@inject IHostRepository Repo
@rendermode InteractiveServer

<PageTitle>Hosts - GigHaus Admin</PageTitle>

<h2>Hosts</h2>

@if (_hosts is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr><th>Name</th><th>Email</th><th>City</th><th>State</th><th>Capacity</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var h in _hosts)
        {
            <tr>
                <td>@h.Name</td>
                <td>@h.Email</td>
                <td>@h.City</td>
                <td>@h.State</td>
                <td>@h.MaxCapacity</td>
                <td><a href="hosts/@h.Id" class="btn btn-sm btn-outline-primary">Dashboard</a></td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private IEnumerable<GigHaus.Domain.Entities.Host>? _hosts;

    protected override async Task OnInitializedAsync()
    {
        _hosts = await Repo.GetAllAsync();
    }
}

