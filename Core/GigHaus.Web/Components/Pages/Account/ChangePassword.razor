@page "/account/password"
@attribute [Authorize]
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> Users
@inject SignInManager<ApplicationUser> SignIn

<PageTitle>Change your password - GigHaus</PageTitle>

<section class="mk-section">
    <div class="mk-wrap mk-narrow mk-auth">
        <h1>Change your password.</h1>

        @if (_done)
        {
            <p class="mk-lead" role="status">Your password is changed.</p>
        }
        else
        {
            <EditForm Model="Input" FormName="change-password" OnValidSubmit="ChangeAsync" class="mk-form">
                <DataAnnotationsValidator />
                <label>
                    Current password
                    <InputText @bind-Value="Input.CurrentPassword" type="password" autocomplete="current-password" />
                    <ValidationMessage For="() => Input.CurrentPassword" />
                </label>
                <label>
                    New password <span class="mk-optional">(at least 10 characters)</span>
                    <InputText @bind-Value="Input.NewPassword" type="password" autocomplete="new-password" />
                    <ValidationMessage For="() => Input.NewPassword" />
                </label>
                <label>
                    Type it again
                    <InputText @bind-Value="Input.ConfirmPassword" type="password" autocomplete="new-password" />
                    <ValidationMessage For="() => Input.ConfirmPassword" />
                </label>

                @if (_error is not null)
                {
                    <p class="mk-error" role="alert">@_error</p>
                }

                <button type="submit" class="mk-btn">Save</button>
            </EditForm>
        }

        <AuthorizeView>
            <p class="mk-auth__links"><a href="@context.User.GetHomePath().TrimStart('/')">Back to your dashboard</a></p>
        </AuthorizeView>
    </div>
</section>

@code {
    private bool _done;
    private string? _error;

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    [SupplyParameterFromForm]
    private ChangePasswordForm Input { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new();

    private async Task ChangeAsync()
    {
        var user = await Users.GetUserAsync((await AuthenticationState).User);
        if (user is null)
        {
            _error = "Please sign in again.";
            return;
        }

        var result = await Users.ChangePasswordAsync(user, Input.CurrentPassword, Input.NewPassword);
        if (!result.Succeeded)
        {
            _error = string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        await SignIn.RefreshSignInAsync(user);
        _done = true;
    }
}
