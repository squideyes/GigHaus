@page "/forgot-password"
@using System.Text
@using GigHaus.Infrastructure.Email
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@inject UserManager<ApplicationUser> Users
@inject IEmailService Email
@inject NavigationManager Nav
@inject ILogger<ForgotPassword> Logger

<PageTitle>Reset your password - GigHaus</PageTitle>

<section class="mk-section">
    <div class="mk-wrap mk-narrow mk-auth">
        <h1>Forgot your password?</h1>

        @if (_sent)
        {
            <p class="mk-lead" role="status">If that email has an account, a reset link is on its way.</p>
        }
        else
        {
            <p class="mk-lead">Enter your email and we'll send you a link to choose a new one.</p>
            <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="SendAsync" class="mk-form">
                <DataAnnotationsValidator />
                <label>
                    Email
                    <InputText @bind-Value="Input.Email" type="email" autocomplete="email" />
                    <ValidationMessage For="() => Input.Email" />
                </label>
                <button type="submit" class="mk-btn">Send the link</button>
            </EditForm>
        }

        <p class="mk-auth__links"><a href="login">Back to sign in</a></p>
    </div>
</section>

@code {
    private bool _sent;

    [SupplyParameterFromForm]
    private ForgotPasswordForm Input { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new();

    private async Task SendAsync()
    {
        // The same message shows either way, so this page can't reveal who has an account.
        var user = await Users.FindByEmailAsync(Input.Email.Trim());
        if (user is not null)
        {
            var token = await Users.GeneratePasswordResetTokenAsync(user);
            var code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(token));
            var link = Nav.ToAbsoluteUri($"reset-password?user={user.Id}&code={code}");

            try
            {
                await Email.SendEmailAsync(new EmailMessage(
                    user.Email,
                    "Reset your GigHaus password",
                    $"<p>Use this link to choose a new password:</p><p><a href=\"{link}\">Reset your password</a></p><p>If you didn't ask for this, you can ignore this email.</p>"));
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                Logger.LogError(ex, "Could not send a password reset email to user {UserId}", user.Id);
            }
        }

        _sent = true;
    }
}
