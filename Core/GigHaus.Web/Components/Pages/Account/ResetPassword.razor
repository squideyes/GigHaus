@page "/reset-password"
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@inject UserManager<ApplicationUser> Users

<PageTitle>Choose a new password - GigHaus</PageTitle>

<section class="mk-section">
    <div class="mk-wrap mk-narrow mk-auth">
        <h1>Choose a new password.</h1>

        @if (_done)
        {
            <p class="mk-lead" role="status">Your password is changed. <a href="login">Sign in</a> with your new one.</p>
        }
        else
        {
            <EditForm Model="Input" FormName="reset-password" OnValidSubmit="ResetAsync" class="mk-form">
                <DataAnnotationsValidator />
                <label>
                    New password <span class="mk-optional">(at least 10 characters)</span>
                    <InputText @bind-Value="Input.Password" type="password" autocomplete="new-password" />
                    <ValidationMessage For="() => Input.Password" />
                </label>
                <label>
                    Type it again
                    <InputText @bind-Value="Input.ConfirmPassword" type="password" autocomplete="new-password" />
                    <ValidationMessage For="() => Input.ConfirmPassword" />
                </label>

                @if (_error is not null)
                {
                    <p class="mk-error" role="alert">@_error</p>
                }

                <button type="submit" class="mk-btn">Save my new password</button>
            </EditForm>
        }
    </div>
</section>

@code {
    private const string InvalidLink = "That link has expired or isn't valid. Please ask for a new one.";

    private bool _done;
    private string? _error;

    [SupplyParameterFromForm]
    private ResetPasswordForm Input { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "user")]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "code")]
    private string? Code { get; set; }

    protected override void OnInitialized() => Input ??= new();

    private async Task ResetAsync()
    {
        var user = UserId is null ? null : await Users.FindByIdAsync(UserId);
        if (user is null || string.IsNullOrEmpty(Code))
        {
            _error = InvalidLink;
            return;
        }

        string token;
        try
        {
            token = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
        }
        catch (FormatException)
        {
            _error = InvalidLink;
            return;
        }

        var result = await Users.ResetPasswordAsync(user, token, Input.Password);
        if (result.Succeeded)
        {
            _done = true;
            return;
        }

        _error = result.Errors.Any(e => e.Code == "InvalidToken")
            ? InvalidLink
            : string.Join(" ", result.Errors.Select(e => e.Description));
    }
}
