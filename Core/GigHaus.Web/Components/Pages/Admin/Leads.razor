@page "/admin/leads"
@rendermode InteractiveServer
@inject ILeadRepository Repository
@inject IHostOnboardingService Onboarding
@inject NavigationManager Nav

<PageTitle>Invitations - GigHaus Admin</PageTitle>

<h1>Invitations</h1>
<p class="text-muted">
    GigHaus is invite only. People ask for an invitation on the site, and you answer by emailing them a sign-up link
    that works once and lasts @((int)HostOnboardingService.InviteLifetime.TotalDays) days.
    A request moves to Signed up on its own when the link is used.
</p>

<form class="lead-card" @onsubmit="InviteNewAsync">
    <h2 class="h5">Invite someone who hasn't asked</h2>
    <div class="row g-2 align-items-end">
        <div class="col-md">
            <label class="form-label" for="invite-name">Name</label>
            <input id="invite-name" class="form-control" @bind="_newName" required maxlength="200" />
        </div>
        <div class="col-md">
            <label class="form-label" for="invite-email">Email</label>
            <input id="invite-email" class="form-control" type="email" @bind="_newEmail" required maxlength="200" />
        </div>
        <div class="col-md-auto">
            <button type="submit" class="btn btn-primary" disabled="@_busy">Send invitation</button>
        </div>
    </div>
</form>

@if (_message is not null)
{
    <p class="@(_failed ? "text-danger" : "text-success") mt-3" role="status">@_message</p>
}

@if (_leads is null)
{
    <p><em>Loading...</em></p>
}
else if (_leads.Count == 0)
{
    <div class="shell-empty">
        <Mascot Size="128" />
        <p>No requests yet. They'll show up here when someone asks for an invitation.</p>
    </div>
}
else
{
    <div class="lead-list mt-3">
        @foreach (var lead in _leads)
        {
            <article class="lead-card">
                <div class="lead-card__head">
                    <div>
                        <h2 class="h5 mb-0">@lead.Name</h2>
                        <a href="mailto:@lead.Email">@lead.Email</a> @lead.Phone
                    </div>
                    <div class="lead-card__status">
                        <label class="visually-hidden" for="status-@lead.Id">Status for @lead.Name</label>
                        <select id="status-@lead.Id" class="form-select form-select-sm" value="@lead.Status"
                                @onchange="e => SetStatusAsync(lead, e.Value?.ToString())">
                            @foreach (var status in Enum.GetValues<LeadStatus>())
                            {
                                @* Invited and Signed up are set by sending and using an invitation. *@
                                <option value="@status" disabled="@(status is LeadStatus.Invited or LeadStatus.SignedUp && status != lead.Status)">@StatusText(status)</option>
                            }
                        </select>
                    </div>
                </div>

                <p class="text-muted mb-1">
                    @(string.Join(", ", new[] { lead.City, lead.State }.Where(v => !string.IsNullOrWhiteSpace(v))))
                    @if (lead.EstimatedCapacity is { } capacity)
                    {
                        <span> (fits about @capacity)</span>
                    }
                    <span> received @lead.CreatedAt.ToString("MMM d, yyyy")</span>
                </p>

                @if (!string.IsNullOrWhiteSpace(lead.Message))
                {
                    <p class="mk-prewrap">@lead.Message</p>
                }

                @if (lead.Status != LeadStatus.SignedUp)
                {
                    <p class="mb-2">
                        <button type="button" class="btn btn-sm @(lead.Status == LeadStatus.Invited ? "btn-outline-primary" : "btn-primary")"
                                disabled="@_busy" @onclick="() => InviteAsync(lead)">
                            @(lead.Status == LeadStatus.Invited ? "Send a new link" : "Send invitation")
                        </button>
                        @if (lead.Status == LeadStatus.Invited && lead.InviteExpiresAt is { } expires)
                        {
                            <span class="text-muted ms-2">
                                Invited @lead.InvitedAt?.ToString("MMM d, yyyy").
                                @(expires < DateTime.UtcNow ? "The link has expired." : $"The link works until {expires:MMM d, yyyy}.")
                            </span>
                        }
                    </p>
                }

                <label class="form-label" for="notes-@lead.Id">Notes</label>
                <textarea id="notes-@lead.Id" class="form-control" rows="2" @bind="lead.Notes" @bind:after="() => Repository.UpdateAsync(lead)"></textarea>
            </article>
        }
    </div>
}

@code {
    private List<Lead>? _leads;
    private string _newName = string.Empty;
    private string _newEmail = string.Empty;
    private string? _message;
    private bool _failed;
    private bool _busy;

    private string SignupUrl => Nav.ToAbsoluteUri("signup").ToString();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() => _leads = [.. await Repository.GetAllAsync()];

    private async Task InviteAsync(Lead lead) =>
        await RunAsync(() => Onboarding.InviteAsync(lead.Id, SignupUrl));

    private async Task InviteNewAsync()
    {
        if (await RunAsync(() => Onboarding.InviteNewAsync(_newName, _newEmail, SignupUrl)))
        {
            _newName = _newEmail = string.Empty;
        }
    }

    private async Task<bool> RunAsync(Func<Task<Result<Lead>>> invite)
    {
        _busy = true;
        try
        {
            var result = await invite();
            _failed = !result.Success;
            _message = result.Success ? $"Invitation sent to {result.Value!.Email}." : result.Error;
            await LoadAsync();
            return result.Success;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SetStatusAsync(Lead lead, string? value)
    {
        if (Enum.TryParse<LeadStatus>(value, out var status))
        {
            lead.Status = status;
            await Repository.UpdateAsync(lead);
        }
    }

    private static string StatusText(LeadStatus status) => status switch
    {
        LeadStatus.Contacted => "Contacted",
        LeadStatus.Invited => "Invited",
        LeadStatus.SignedUp => "Signed up",
        LeadStatus.NotInterested => "Declined",
        _ => "Requested"
    };
}
