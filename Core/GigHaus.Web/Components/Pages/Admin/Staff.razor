@page "/admin/staff"
@rendermode InteractiveServer
@inject IStaffService StaffService

<PageTitle>Staff - GigHaus Admin</PageTitle>

<h1>Staff</h1>
<p class="text-muted">Everyone here can reach the admin area and see host addresses.</p>

@if (_error is not null)
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

<div class="table-responsive">
    <table class="table align-middle">
        <thead><tr><th>Name</th><th>Email</th><th></th></tr></thead>
        <tbody>
            @foreach (var person in _staff)
            {
                <tr>
                    <td>@person.DisplayName</td>
                    <td>@person.Email</td>
                    <td class="text-end">
                        @if (person.Id != _currentUserId)
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveAsync(person.Id)">Remove</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<h2 class="h4 mt-4">Add a staff member</h2>
<EditForm Model="_input" OnValidSubmit="AddAsync" class="shell-form">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label" for="staff-name">Name</label>
        <InputText id="staff-name" class="form-control" @bind-Value="_input.DisplayName" />
        <ValidationMessage For="() => _input.DisplayName" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="staff-email">Email</label>
        <InputText id="staff-email" class="form-control" type="email" @bind-Value="_input.Email" />
        <ValidationMessage For="() => _input.Email" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="staff-password">Temporary password</label>
        <InputText id="staff-password" class="form-control" type="password" autocomplete="new-password" @bind-Value="_input.Password" />
        <div class="form-text">Share this with them securely and ask them to change it after signing in.</div>
        <ValidationMessage For="() => _input.Password" />
    </div>

    <button type="submit" class="btn btn-primary">Add staff member</button>
</EditForm>

@code {
    private IReadOnlyList<ApplicationUser> _staff = [];
    private StaffForm _input = new();
    private Guid _currentUserId;
    private string? _error;

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _currentUserId = (await AuthenticationState).User.GetUserId();
        _staff = await StaffService.GetStaffAsync();
    }

    private async Task AddAsync()
    {
        var result = await StaffService.AddAsync(_input.DisplayName, _input.Email, _input.Password);
        _error = result.Error;

        if (result.Success)
        {
            _input = new StaffForm();
            _staff = await StaffService.GetStaffAsync();
        }
    }

    private async Task RemoveAsync(Guid id)
    {
        var result = await StaffService.RemoveAsync(id, _currentUserId);
        _error = result.Error;
        _staff = await StaffService.GetStaffAsync();
    }
}
